FLASK_SECRET_KEY=replace-with-long-random-secret
ADMIN_PASSWORD=change-this-password
SESSION_COOKIE_SECURE=false
DATABASE_PATH=volunteer_app.db
PORT=10000

# Scheduled volunteer reminders (use the same secret in GitHub Actions)
REMINDER_JOB_TOKEN=

# Twilio signup alerts and optional volunteer reminders (leave blank until configured)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_ALERT_PHONE=
